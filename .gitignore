## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# ─────────────────────────────────────────────
# Build results
# ─────────────────────────────────────────────
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
[Oo]ut/
[Pp]ublish/
artifacts/
*.dll
*.exe
*.pdb
*.deps.json
*.runtimeconfig.json

# ─────────────────────────────────────────────
# .NET Core / SDK
# ─────────────────────────────────────────────
project.lock.json
project.fragment.lock.json
*.deps.json
*.runtimeconfig.json
*.nuget.props
*.nuget.targets

# ─────────────────────────────────────────────
# ASP.NET Scaffolding
# ─────────────────────────────────────────────
ScaffoldingReadMe.txt

# ─────────────────────────────────────────────
# NuGet Packages
# ─────────────────────────────────────────────
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets
packages/
!packages/build/
!packages/*.props

# ─────────────────────────────────────────────
# Test Results & Coverage
# ─────────────────────────────────────────────
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
TestResult.xml
nunit-*.xml
*.trx
coverage*.json
coverage*.xml
coverage*.info
coverage*.cobertura.xml
*.coverage
*.coveragexml
[Cc]overage[Rr]eport/
codecov/
coverlet/

# ─────────────────────────────────────────────
# BenchmarkDotNet
# ─────────────────────────────────────────────
BenchmarkDotNet.Artifacts/
*.benchmark.json

# ─────────────────────────────────────────────
# Visual Studio
# ─────────────────────────────────────────────
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.rsuser
*.buildlog
*.tlog
*.cache
.vscache/

# ─────────────────────────────────────────────
# JetBrains Rider / IntelliJ
# ─────────────────────────────────────────────
.idea/
*.sln.iml
*.suo
_modules/
*.DotSettings.user

# ─────────────────────────────────────────────
# VS Code
# ─────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
*.code-workspace
.history/
*.vsix

# ─────────────────────────────────────────────
# Docker
# ─────────────────────────────────────────────
docker-compose.override.yml
.dockerignore

# ─────────────────────────────────────────────
# Azure / Publish
# ─────────────────────────────────────────────
*.pubxml
*.pubxml.user
PublishProfiles/
.publishsettings
*.azurePubxml

# ─────────────────────────────────────────────
# Environment / Local Config
# ─────────────────────────────────────────────
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.Local.json
*.local.json

# ─────────────────────────────────────────────
# OS Files
# ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ─────────────────────────────────────────────
# Merge / Rebase / Backup
# ─────────────────────────────────────────────
*.bak
*.orig
*.tmp
*.temp
*.swp
*~*
~$*
*.rej

# ─────────────────────────────────────────────
# MSBuild
# ─────────────────────────────────────────────
*.binlog
*.log
msbuild.log
msbuild.err
msbuild.wrn

# ─────────────────────────────────────────────
