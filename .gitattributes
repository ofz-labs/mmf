# ═══════════════════════════════════════════════════════════════════
# MMF — Git attributes
# Satır sonu standardizasyonu ve binary dosya tespiti
# ═══════════════════════════════════════════════════════════════════

# Varsayılan: Tüm metin dosyaları LF olarak saklanır, çalışma dizininde
# kullanıcının işletim sistemine göre checkout edilir.
* text=auto eol=lf

# Windows'a özgü script'ler CRLF kalmalı
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Shell script'leri LF kalmalı
*.sh   text eol=lf

# Binary dosyalar — Git içeriği değiştirmesin
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.dll  binary
*.exe  binary
*.zip  binary
*.tar  binary
*.gz   binary
*.7z   binary

# .NET özel
*.slnx  text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.nuspec text eol=lf

# Dokümantasyon
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
