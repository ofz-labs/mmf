<Project>

  <!-- Kök Directory.Build.props'u açıkça import et (yoksa yukarı doğru arama durur) -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- tests/ altındaki projelere özel ayarlar -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- IDE0005 (gereksiz using) build sırasında çalışsın -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: Test kodunda XML doc yorumu zorunlu değil -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
